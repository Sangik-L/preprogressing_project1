.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env

# 원본·중간·완료 데이터는 저장소에 직접 올리지 않는다.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# 실행 결과는 폴더 구조만 추적한다.
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
